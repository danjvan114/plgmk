5f58a0c3-0d00-47bb-b11c-f5dcac7a9539","b0d6aceb-197c-4387-8e47-5f7950a5dc1f","b4161c41-0ee7-4780-b460-fab6708ebb7e","27dff8d0-4afc-475d-952b-f120d7eeaf58","420438ac-c784-433c-a937-2e73de0e9c99","48a40313-6807-4422-bbb5-c2f7680b0f9e","3621d605-2534-4672-9cb6-ba74615bbee6","59b92932-d66d-45af-b327-2d9f9580b104","b8c7fb76-0e17-4e7e-a929-83d57a28dd20","c08aa912-22fe-4428-bfff-b963686c69ef"],"currentStyleId":"1ad7b960-2805-45a5-b165-fc2ef7349726","comments":{}},"7a337426-e32d-4eb8-aac5-b07bbbebc438":{"id":"7a337426-e32d-4eb8-aac5-b07bbbebc438","position":{"x":-236,"y":-50},"scale":100,"locked":false,"rotation":0,"nekoBlockJsonList":[{"type":"on_running_group_activated","id":"RT4HWpmTlWdX0knrEfdi","collapsed":true,"shadows":{"_TEMP_COLLAPSED_INPUT":""},"shield":false,"parent_id":"","next":{"type":"set_system_preset","id":"P2cq3zZNCdX3PMjJ8IZt","shadows":{"text":"<shadow xmlns=\"http://www.w3.org/1999/xhtml\" type=\"multiline_text\" id=\"hoH9oAheb2qiRofpz4mh\" visible=\"visible\"><field name=\"TEXT\">你是一个回答农业、美食相关的AI，不要弯弯绕绕，直接给答案，文字不需要太复杂，尽量简洁</field></shadow>"},"parent_id":"RT4HWpmTlWdX0knrEfdi","shield":false,"inputs":{"text":{"type":"multiline_text","id":"hoH9oAheb2qiRofpz4mh","is_shadow":true,"fields":{"TEXT":"你现在是一名专业的线下实体卡牌商店全职售卖店员，人设亲切干练、务实接地气，只解答和卡牌售卖、卡牌玩法、卡牌品级、卡牌定价、交易规则、卡牌保养、卡组搭配、进货选购相关问题，其他问题也要耐心回答。\n \n1. 业务能力：清晰区分普通、稀有、史诗、传说、限定卡牌等级，熟练讲解单卡售价、整套打包价格、置换规则、二手回收估价；\n​\n2. 回答风格：拒绝长篇大论，口语化简洁直白，顾客问价格直接报区间，问玩法讲核心要点，问养护给出简单可行办法；\n​\n3. 接待逻辑：顾客咨询购买需求，主动给出选购建议；询问卡牌价值客观估价；闲聊非卡牌业务统一回复：“我只负责卡牌售卖相关咨询哦，其他问题没法解答”；\n​\n4. 交易细节：可说明零售、整盒批发、以卡换卡、瑕疵卡折价等店内完整交易规则，全程保持店员服务语气。\n5用户提问例如:白菜多少钱？\n可以根据现实中的市场价来回答。\n回答:例如:根据最新的价格，为10~20元一张卡牌"},"is_output":true,"parent_id":"P2cq3zZNCdX3PMjJ8IZt","shield":false}}}},{"type":"sprite_on_tap","id":"J6EcqikStbeO9rt65ja9","location":[-30,238.00025939941406],"fields":{"type":"mouse_click","sprite":"--self"},"shield":false,"parent_id":"","next":{"type":"self_ask","id":"kVVNEWqYac5cT6UfT0Nr","shadows":{"text":"<shadow xmlns=\"http://www.w3.org/1999/xhtml